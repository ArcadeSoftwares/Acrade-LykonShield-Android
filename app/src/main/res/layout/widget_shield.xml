<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="horizontal"
    android:gravity="center_vertical"

    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"

    android:background="#121212">

    <!-- LEFT -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LYKON SHIELD"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/widget_total_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1,794"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/widget_total_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="#8E8E93"
            android:textSize="9sp"
            android:maxLines="1"/>

    </LinearLayout>

    <!-- CHART -->
    <ImageView
        android:id="@+id/widget_pie_chart"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerInside"
        android:contentDescription="Blocked categories"/>

    <!-- RIGHT -->
    <LinearLayout
        android:id="@+id/widget_legend_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/row_0"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/row_0_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="5dp"/>

            <TextView
                android:id="@+id/row_0_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/row_0_percent"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="9sp"/>

            <TextView
                android:id="@+id/row_0_count"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#8E8E93"
                android:textSize="8sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_1"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/row_1_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="5dp"/>

            <TextView
                android:id="@+id/row_1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/row_1_percent"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="9sp"/>

            <TextView
                android:id="@+id/row_1_count"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#8E8E93"
                android:textSize="8sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_2"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/row_2_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="5dp"/>

            <TextView
                android:id="@+id/row_2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/row_2_percent"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="9sp"/>

            <TextView
                android:id="@+id/row_2_count"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#8E8E93"
                android:textSize="8sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No blocks yet"
            android:textColor="#8E8E93"
            android:textSize="9sp"
            android:gravity="center"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
